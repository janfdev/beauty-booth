# ==============================================================================
# LoveFun ("Love is Fun") Environment Variables Configuration
# Salin file ini menjadi .env.local untuk development atau masukkan ke Vercel Environment
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL / NeonDB / Supabase)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/lovefun?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/lovefun?sslmode=require"

# 2. NEXTAUTH / SESSION AUTHENTICATION
NEXTAUTH_URL="https://fun.fizaa.me"
NEXTAUTH_SECRET="lovefun-super-secure-secret-key-at-least-32-characters"

# 3. PRIVATE SUPER ADMIN ACCESS (/dashboard)
# Gunakan secret token ini untuk masuk ke panel /dashboard privat
SUPER_ADMIN_KEY="lovefun_admin_secret_passphrase_2026"

# 4. CLOUDINARY MEDIA STORAGE (Photo Strip & Profil History)
# Dapatkan kredensial gratis di https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_UPLOAD_PRESET="lovefun_strip_preset"
