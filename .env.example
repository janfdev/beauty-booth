# ==============================================================================
# LoveFun ("Love is Fun") Environment Variables Configuration
# Salin file ini menjadi .env.local atau masukkan ke Vercel Environment Variables
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL / NeonDB / Supabase)
# Cukup satu DATABASE_URL tunggal untuk seluruh aplikasi dan migrasi tabel
DATABASE_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. GOOGLE OAUTH CONFIGURATION (Login dengan Akun Google)
# Dapatkan Client ID & Secret di Google Cloud Console (APIs & Services -> Credentials)
# Authorized redirect URI: https://fun.fizaa.me/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 3. JWT SESSION SECRET
# String acak minimal 32 karakter untuk mengenkripsi cookie token login pengguna
JWT_SECRET="lovefun-secure-jwt-secret-session-key-at-least-32-characters"

# 4. SUPER ADMIN EMAIL WHITELIST
# Email Google Anda yang secara otomatis mendapatkan wewenang SUPER_ADMIN untuk mengakses /dashboard
SUPER_ADMIN_EMAILS="fauzanrizqinoor@gmail.com"

# 5. CLOUDINARY MEDIA STORAGE (Photo Strip & Profil History)
# Cukup 3 kredensial resmi dari Cloudinary Dashboard (Settings -> Access Keys)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
